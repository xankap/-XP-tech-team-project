DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
JWT_SECRET=replace-with-64-char-hex
PORT=3000
RUN_SERVER=1

# Sendchamp SMS (POST /auth/send-sms-code)
# Public key: my.sendchamp.com -> Settings -> API Keys. Never commit real values.
SENDCHAMP_PUBLIC_KEY=
# Sender name; defaults to "Sendchamp" until your own sender ID is approved.
SENDCHAMP_SENDER_NAME=
# DND_NG (default, works for OTP), NON_DND_NG or PREMIUM_NG.
SENDCHAMP_ROUTE=

GOOGLE_CLIENT_ID=

# Sendchamp Email API (verification + welcome emails). Uses SENDCHAMP_PUBLIC_KEY above.
# Requires an active Email subscription on your Sendchamp account (billed from the same wallet).
# Email is only sent when SENDCHAMP_EMAIL_FROM is set; /health reports emailConfigured.
SENDCHAMP_EMAIL_FROM=
SENDCHAMP_EMAIL_FROM_NAME=XP GasTech
# Base URLs used to build the verification link / "open app" button.
API_BASE_URL=https://api.xptechltd.com
APP_BASE_URL=https://xptechltd.com
# Optional template overrides (placeholders: {{name}} {{link}} {{app_url}}):
# EMAIL_VERIFY_SUBJECT=
# EMAIL_VERIFY_HTML=
# EMAIL_WELCOME_SUBJECT=
# EMAIL_WELCOME_HTML=
# Optional SMS OTP text override; must contain {{code}}.
# SMS_OTP_TEMPLATE=Your XP GasTech verification code is {{code}}. It expires in 10 minutes.

# Browser origins allowed by CORS (comma-separated, exact match), e.g. the deployed web app
# and Vercel preview/production URLs. localhost origins are always allowed.
CORS_ORIGINS=https://xptechltd.com,https://www.xptechltd.com

# Login sessions (optional; defaults shown). Requires sql/005_auth_sessions.sql.
# JWT_ACCESS_TTL=1h
# REFRESH_TOKEN_TTL_DAYS=60
