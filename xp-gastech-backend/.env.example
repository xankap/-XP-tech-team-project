SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
JWT_SECRET=replace-with-64-char-hex
PORT=3000
RUN_SERVER=1

# Twilio SMS (POST /auth/send-sms-code)
# 1) Sign up at https://www.twilio.com/try-twilio — choose Continue with trial (no card required).
# 2) Verify your email and personal phone number.
# 3) Console home: copy Account SID + Auth Token (Account > API keys & tokens).
# 4) Messaging > Try out SMS (or Phone Numbers): note the Twilio trial From number (E.164, e.g. +1...).
# 5) Trial can ONLY text verified recipients (signup number auto-verified; add more under Try out SMS, max ~5).
# 6) Paste values below into your local .env (never commit .env).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

GOOGLE_CLIENT_ID=
